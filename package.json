{
  "name": "hookline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn one long-form transcript into a week of publishable channel output.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "cli": "tsx src/cli/run.ts",
    "demo": "tsx src/cli/run.ts samples/the-algorithm-episode.srt --out out/demo",
    "og": "tsx tools/export-og-curve.ts && node tools/build-og.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand": "node tools/brand/render.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/inter-tight": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.9"
  }
}
